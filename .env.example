# Copy to .env and change every secret before any shared or production deployment.
# These values are local-development defaults only.

APP_NAME=ObservePro
ENVIRONMENT=development
SECRET_KEY=dev-only-change-me
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme
JWT_TTL_HOURS=12

DATABASE_URL=sqlite:///./data/observe.db
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=600
MAX_BODY_BYTES=1048576
RETENTION_DAYS=14
LOG_LEVEL=INFO

# Creates a "default" project on startup and writes an API key to DEV_API_KEY_FILE.
# Leave false outside local Docker.
DEV_BOOTSTRAP=false
DEV_PROJECT_SLUG=default
DEV_API_KEY_FILE=

# Shared by the API and the OpenTelemetry Collector in docker-compose.
# Ignored when ENVIRONMENT=production if left as the dev placeholder.
COLLECTOR_INGEST_TOKEN=dev-only-collector-token

OTLP_GRPC_ENABLED=false
OTLP_GRPC_PORT=4319
WORKER_INTERVAL_SECONDS=15
RETENTION_INTERVAL_SECONDS=3600
